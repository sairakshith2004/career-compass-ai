# Copy this file to .env and fill in the values you have. The app runs fine
# with none of these set — login buttons just show as "not configured" until
# their provider's keys are added.

# --- Database -----------------------------------------------------------
# Local dev needs nothing here — defaults to a local file `dev.db`.
# For production, create a free database at https://turso.tech and paste
# its libsql:// URL + auth token here (same driver, zero code changes).
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=

# --- Auth -----------------------------------------------------------------
# Secret used to sign session cookies and reset tokens. REQUIRED in production
# (the server refuses to boot without it); in dev a random per-process value is
# used if left blank (sessions drop on restart).
# Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public origin of the app. Used as the cookie domain and the allowed origin for
# better-auth's same-origin (CSRF) check — set it to your real HTTPS domain in
# production, e.g. https://worklens.example.com
BETTER_AUTH_URL=http://localhost:3000

# Set by your host, not here — just documenting it: in production
# (NODE_ENV=production) session cookies are issued Secure + the app sends HSTS
# and a strict Content-Security-Policy. Password reset emails need a real
# transactional-email provider wired into `sendResetPassword` in src/lib/auth.ts
# (in dev the reset link is printed to the server console).

# Escape hatch for load-testing / the automated auth test suite only — leave
# unset in every real environment. When "true", better-auth's rate limiter is
# turned off.
# AUTH_RATE_LIMIT_DISABLED=

# --- Resume AI analysis (Phase 4) ------------------------------------------
# Resume analysis calls the Anthropic API server-side. Without a key, uploads
# still store + extract text, but the AI analysis step reports "not available".
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional overrides:
# RESUME_AI_MODEL=claude-opus-5           # default; set claude-sonnet-5 to cut cost
# RESUME_AI_TIMEOUT_MS=120000
# RESUME_MAX_BYTES=5242880                # 5 MB upload cap
# RESUME_UPLOAD_DIR=./uploads/resumes     # private, never served publicly
# RESUME_MALWARE_SCAN_CMD=clamdscan -     # external AV: file on stdin, exit 0 = clean

# --- Google OAuth -----------------------------------------------------
# 1. https://console.cloud.google.com/apis/credentials -> Create OAuth client ID
# 2. Application type: Web application
# 3. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#    (in production: https://yourdomain.com/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth -----------------------------------------------------
# 1. https://github.com/settings/developers -> New OAuth App
# 2. Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- LinkedIn OAuth ---------------------------------------------------
# 1. https://www.linkedin.com/developers/apps -> Create app
# 2. Add the "Sign In with LinkedIn using OpenID Connect" product
# 3. Authorized redirect URL: http://localhost:3000/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
